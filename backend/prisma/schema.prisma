generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cat_images {
  image_id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cat_id             String               @db.Uuid
  image_url          String
  file_name          String?              @db.VarChar(255)
  is_saved_to_album  Boolean              @default(false)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  cats               cats                 @relation(fields: [cat_id], references: [cat_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cat_images_cat")
  emotion_detections emotion_detections[]
}

model cats {
  cat_id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id         String               @db.Uuid
  name               String               @db.VarChar(100)
  breed              String?              @db.VarChar(100)
  sex                String?              @db.VarChar(20)
  age                Int?
  birthdate          DateTime?            @db.Date
  description        String?
  profile_image_url  String?
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)

  cat_images         cat_images[]
  profiles           profiles             @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cats_profile")
  emotion_detections emotion_detections[]
}

model emotion_categories {
  emotion_id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emotion_name       String               @unique @db.VarChar(50)
  description        String?
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  emotion_detections emotion_detections[]
  recommendations    recommendations[]
}

model emotion_detections {
  detection_id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cat_id             String             @db.Uuid
  image_id           String?            @db.Uuid
  emotion_id         String             @db.Uuid
  confidence_score   Decimal?           @db.Decimal(5, 4)
  detected_at        DateTime?          @default(now()) @db.Timestamptz(6)
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  cats               cats               @relation(fields: [cat_id], references: [cat_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_detections_cat")
  emotion_categories emotion_categories @relation(fields: [emotion_id], references: [emotion_id], onUpdate: NoAction, map: "fk_detections_emotion")
  cat_images         cat_images?        @relation(fields: [image_id], references: [image_id], onUpdate: NoAction, map: "fk_detections_image")
}

model feedback {
  feedback_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id  String?   @db.Uuid
  title       String?   @db.VarChar(150)
  email       String    @db.VarChar(255)
  subject     String?   @db.VarChar(255)
  message     String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  profiles    profiles? @relation(fields: [profile_id], references: [profile_id], onUpdate: NoAction, map: "fk_feedback_profile")
}

model profiles {
  profile_id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  google_id         String     @unique @db.VarChar(255)
  email             String     @unique @db.VarChar(255)
  first_name        String?    @db.VarChar(100)
  last_name         String?    @db.VarChar(100)
  profile_image_url String?
  created_at        DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?  @default(now()) @db.Timestamptz(6)
  cats              cats[]
  feedback          feedback[]
}

model recommendations {
  recommendation_id   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emotion_id          String             @db.Uuid
  title               String             @db.VarChar(150)
  recommendation_text String
  created_at          DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?          @default(now()) @db.Timestamptz(6)
  emotion_categories  emotion_categories @relation(fields: [emotion_id], references: [emotion_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recommendations_emotion")
}
