{
  "expo": {
    "name": "FeELINE",
    "slug": "feeline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/bluecircle.png",
    "scheme": "feeline",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feeline.app"
    },
    "android": {
      "package": "com.feeline.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7E9",
          "dark": {
            "backgroundColor": "#FFF7E9"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FeELINE to use the camera to capture cat images.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow FeELINE to use the camera to capture cat images.",
          "photosPermission": "Allow FeELINE to access a photo selected by you for observable emotional-cue interpretation.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FFF7E9"
  }
}
