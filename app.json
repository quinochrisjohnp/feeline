{
  "expo": {
    "name": "FeELINE",
    "slug": "feeline",
    "owner": "feeline",
    "icon": "./components/images/logo-only.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "feeline",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feeline.app",
      "icon": "./components/images/logo-ios.png"
    },
    "android": {
      "package": "com.feeline.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "icon": "./components/images/logo-ios.png",
      "adaptiveIcon": {
        "foregroundImage": "./components/images/logo-adaptive-foreground.png",
        "backgroundColor": "#FFF7E9"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#FFF7E9",
          "dark": {
            "backgroundColor": "#FFF7E9",
            "image": "./components/images/splash-blank.png"
          },
          "image": "./components/images/splash-blank.png"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FeELINE to use the camera to capture cat images.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow FeELINE to use the camera to capture cat images.",
          "photosPermission": "Allow FeELINE to access a photo selected by you for observable emotional-cue interpretation.",
          "microphonePermission": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./components/images/notification-icon.png",
          "color": "#3B2A20"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FFF7E9",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "41df5527-c8b4-4d80-8b39-d2de3d7051ce"
      }
    }
  }
}
